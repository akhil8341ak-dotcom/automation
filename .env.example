# ==============================================================================
# CreatorFlow AI Environment Configuration
# ==============================================================================

# Server & Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CLIENT_PORT=5173
API_BASE_URL=http://localhost:3001

# Storage & Database
SQLITE_DB_PATH=./data/creatorflow.db
STORAGE_PATH=./data/storage
TEMP_RENDER_DIR=./data/temp

# AI Provider Settings (Choose your active provider or use mock/offline mode)
# Options: 'gemini', 'openai', 'anthropic', 'ollama', 'mock'
DEFAULT_AI_PROVIDER=gemini

# Google Gemini API (Recommended for generous free tier)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Ollama Host (Optional, for 100% offline free local inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Text-To-Speech (TTS) Provider
# Options: 'edge-tts' (Default, 100% free high-quality neural voices), 'openai', 'mock'
DEFAULT_TTS_PROVIDER=edge-tts
DEFAULT_VOICE=en-US-ChristopherNeural

# Stock Asset Providers (Optional - free keys available)
# Pexels API: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
# Pixabay API: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# YouTube Data API v3 OAuth2 Configuration
# Setup at: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/oauth2callback

# Security & Encryption Key (32-character string for local credential vault)
ENCRYPTION_SECRET=creatorflow-secure-encryption-key-32chars!!

# Production & Quality Policies
REQUIRE_SCRIPT_APPROVAL=true
REQUIRE_RENDER_APPROVAL=true
REQUIRE_PUBLISH_APPROVAL=true
DEFAULT_PRIVACY_STATUS=private
MAX_CONCURRENT_RENDERS=2
